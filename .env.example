# Copy to backend/.env and fill in. Never commit real values.
REDFIRST_ENV=development
REDFIRST_DATABASE_URL=postgresql+psycopg://redfirst:redfirst@localhost:5432/redfirst
REDFIRST_DATA_DIR=./data

REDFIRST_LLM_PROVIDER=anthropic
REDFIRST_LLM_MODEL=claude-opus-5-5
REDFIRST_LLM_EFFORT=high
REDFIRST_LLM_REFUSAL_FALLBACKS=true
# Leave empty to let the Anthropic SDK use ANTHROPIC_API_KEY or your `ant auth login` profile.
REDFIRST_LLM_API_KEY=

# Abuse controls
REDFIRST_LLM_TOKEN_BUDGET_PER_INVESTIGATION=200000
REDFIRST_LLM_MAX_CALLS_PER_DAY=200
REDFIRST_MAX_PENDING_INVESTIGATIONS=20

REDFIRST_MAX_GENERATION_ATTEMPTS=3
REDFIRST_REPRODUCTION_RUNS=3
REDFIRST_RETENTION_DAYS=30
